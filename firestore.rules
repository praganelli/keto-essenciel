rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /premium_emails/{email} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'infos@essencielonaturel.fr';
      allow create, update: if request.auth != null
                            && email == request.auth.token.email.lower()
                            && request.resource.data.owner_uid == request.auth.uid;
    }
    match /premium_codes/{code} {
      allow read: if true;
      allow create, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
      allow update: if request.auth != null && (
        request.auth.token.email == 'infos@essencielonaturel.fr'
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used_by', 'last_used_at'])
      );
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /keto-data/{code} {
      allow read, write: if true;
    }
    // ═══ Activité utilisateurs (connexions & inscriptions) ═══
    match /user_activity/{docId} {
      // Tout utilisateur authentifié peut créer SON entrée d'activité
      allow create: if request.auth != null
                    && request.resource.data.email == request.auth.token.email;
      // Seul l'admin peut lire toute la collection (pour le Dashboard)
      allow read: if request.auth != null
                  && request.auth.token.email == 'infos@essencielonaturel.fr';
      // Entrées immuables : pas de update / pas de delete
      allow update, delete: if false;
    }
    // ═══ Programme de parrainage (referral codes) ═══
    match /referral_codes/{code} {
      // Lecture publique : permet de valider un code reçu par un proche
      // (même avant authentification complète) et de partager des liens
      allow read: if true;
      // Création : seul le propriétaire peut créer son propre code
      // (owner_uid doit correspondre à l'uid de l'utilisateur authentifié)
      // OU l'admin peut créer des codes promotionnels
      allow create: if request.auth != null
                    && (
                      request.resource.data.owner_uid == request.auth.uid
                      || request.auth.token.email == 'infos@essencielonaturel.fr'
                    );
      // Update :
      //   - Admin : autorisé total (active/désactive, modifie reward_days, etc.)
      //   - Tout authentifié : autorisé UNIQUEMENT à modifier
      //     used_by + use_count + last_used_at (pour qu'un filleul puisse
      //     marquer le code comme utilisé lors de son inscription)
      allow update: if request.auth != null && (
        request.auth.token.email == 'infos@essencielonaturel.fr'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['used_by', 'use_count', 'last_used_at'])
      );
      // Suppression : admin uniquement
      allow delete: if request.auth != null
                    && request.auth.token.email == 'infos@essencielonaturel.fr';
    }
    // ═══ Suppléments LPEV (catalogue affiliation + tracking clics) ═══
    match /lpev_supplements/{docId} {
      // Lecture : tout utilisateur authentifié peut consulter le catalogue
      allow read: if request.auth != null;
      // Création / Suppression : admin uniquement
      allow create, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
      // Update :
      //   - Admin : autorisé total (modifie nom, prix, lien, pathologies, etc.)
      //   - Tout authentifié : autorisé UNIQUEMENT à incrémenter les compteurs
      //     de clics (click_count + last_clicked_at) pour le tracking affiliation
      allow update: if request.auth != null && (
        request.auth.token.email == 'infos@essencielonaturel.fr'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['click_count', 'last_clicked_at'])
      );
    }
    // ═══ Recettes personnalisées ajoutées par l'admin ═══
    match /custom_recipes/{docId} {
      // Lecture PUBLIQUE : tous les utilisateurs (y compris invités non
      // authentifiés) doivent pouvoir charger les recettes au démarrage
      allow read: if true;
      // Création / Mise à jour / Suppression : admin uniquement
      allow create, update, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
    }
    // ═══ Contenu « Renforcement musculaire » (programmes & conseils) ═══
    match /muscle_content/{docId} {
      // Lecture PUBLIQUE : le contenu est chargé côté client puis affiché
      // uniquement aux membres Premium (gating géré dans l'application)
      allow read: if true;
      // Création / Mise à jour / Suppression : admin uniquement
      allow create, update, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
    }
    // ═══ Surcharges de recettes « en dur » (modifications par l'admin) ═══
    match /recipe_overrides/{docId} {
      // Lecture PUBLIQUE : appliquées au démarrage pour tous les utilisateurs
      allow read: if true;
      // Écriture : admin uniquement
      allow create, update, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
    }
    // ═══ Suppressions de recettes « en dur » (pierres tombales admin) ═══
    match /recipe_deletions/{docId} {
      // Lecture PUBLIQUE : appliquées au démarrage pour masquer les recettes
      allow read: if true;
      // Écriture : admin uniquement (créer = supprimer, effacer = restaurer)
      allow create, update, delete: if request.auth != null
                            && request.auth.token.email == 'infos@essencielonaturel.fr';
    }
  }
}
